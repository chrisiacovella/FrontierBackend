#!/usr/bin/env bash
#SBATCH -J eq_CO_O_s1
#SBATCH -p gpu
#SBATCH -t 0-2:00:00
#SBATCH --nodes=2
#SBATCH --gpus-per-node=4
#SBATCH --cpus-per-task=1
#SBATCH --tasks-per-node=4
#SBATCH --mem=16gb
#SBATCH --output slurm-%x.%A.out

. ~/.bashrc

PORT=8217
# Use the right conda environment
micromamba activate ash-sage-refit

# Note, task-per-node and gpus-per-node should match as we want each task to have a GPU.

# Get the total resources we have been allocated for this script, which will be passed to srun
TOTAL_RESOURCES=$(( SLURM_JOB_NUM_NODES * SLURM_NTASKS_PER_NODE))

# The TOTAL_WORKERS will be 2 less the total resources, as we need 2 workers for dask server and scheduler.
# When we call the python script we pass the TOTAL_WORKERS, used to set the number of workers for the dask client.
TOTAL_WORKERS=$(( TOTAL_RESOURCES - 2 ))


# echo the environment variables for debugging
echo "SLURM_JOB_NUM_NODES: $SLURM_JOB_NUM_NODES"
echo "SLURM_NODELIST: $SLURM_NODELIST"
echo "SLURM_NTASKS: $SLURM_NTASKS"
echo "SLURM_NTASKS_PER_NODE: $SLURM_NTASKS_PER_NODE"
echo "TOTAL_WORKERS: $TOTAL_WORKERS"
echo "TOTAL_RESOURCES: $TOTAL_RESOURCES"

export DASK_DISTRIBUTED__COMM__INTERFACE="ib0"

start=$(date +%s)

srun --overlap --ntasks="$TOTAL_RESOURCES" --ntasks-per-node="$SLURM_NTASKS_PER_NODE"\
    python equilibrate-slurm-preallocate.py \
        --n-workers "$TOTAL_WORKERS" \
        --port                      "$PORT"                             \
        --dataset                   "./training-set.json"                       \
        --force-field               "./force-field.offxml"                     \

end=$(date +%s)
echo "Elapsed Time: $(($end-$start)) seconds"

